<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- El vínculo con Giraffe Music, si está instalada (solo apps firmadas con la misma llave).
         Se declara también acá para que funcione sin importar cuál de las dos se instaló primero. -->
    <permission android:name="com.giraffe.music.permission.CAR_BRIDGE" android:protectionLevel="signature" />
    <uses-permission android:name="com.giraffe.music.permission.CAR_BRIDGE" />

    <queries>
        <package android:name="com.giraffe.music" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.CarMusic"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!-- Android Auto: es una app de música. -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="com.google.android.gms.car.notification.SmallIcon" android:resource="@drawable/ic_notification" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El reproductor y el menú que ve el auto. -->
        <service
            android:name=".CarService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Las carátulas para el auto (Android Auto las pide como content://). -->
        <provider
            android:name=".ArtProvider"
            android:authorities="com.giraffe.carmusic.art"
            android:exported="true" />

        <!-- Iniciar sesión con Google (la página de Google, la contraseña no pasa por CarMusic). -->
        <activity android:name=".LoginActivity" android:exported="false" />

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver android:name=".UpdateReceiver" android:exported="false" />
    </application>
</manifest>
